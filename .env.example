# The proxy is local-only by default. Change this only if you understand the exposure.
FAST_PROXY_BIND=127.0.0.1
FAST_PROXY_PORT=18081

# Existing Sub2API address as seen from the proxy container.
SUB2API_URL=http://host.docker.internal:8081

# Comma-separated model IDs, or * for every model.
PRIORITY_MODELS=gpt-5.6-sol

# OpenAI accepts both fast and priority. fast is the current public name.
FAST_SERVICE_TIER=fast

# Comma-separated Sub2API Responses endpoint aliases.
RESPONSE_PATHS=/v1/responses,/responses,/backend-api/codex/responses

# Maximum inspected JSON request size (64 MiB by default).
MAX_BODY_BYTES=67108864
